//---------------------- keybinds ----------------------\\
// Mod is Super when niri runs on a TTY.
binds {

    // ---- applications ----
    Mod+T           { spawn "alacritty"; }            // Open a terminal
    Mod+Return         { spawn "open-browser"; }
    Mod+A                { spawn-sh "quickshell ipc call dashboard-launcher toggle"; }     // Open the Apps page in the bar
    Mod+E                { spawn "thunar"; }          // File manager

    // ---- clipboard (work from any keyboard layout) ----
    // wtype injects a latin Ctrl+C/V/X keysym, so copy/paste/cut work even
    // when the Cyrillic layout is active (app-level Ctrl+* would send "с/м/ч").
    Mod+Shift+V          { spawn "wtype" "-M" "ctrl" "-k" "v"; }     // Paste
    Mod+X                { spawn "wtype" "-M" "ctrl" "-k" "x"; }     // Cut

    // ---- audio ----
    F9                    allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }       // Mute or unmute the audio
    F10                   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }      // Lower the volume
    F11                   allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"; }      // Raise the volume

    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+"; }      // Raise the volume (media key)
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }      // Lower the volume (media key)
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }       // Mute or unmute the audio (media key)

    // ---- windows and columns ----
    Mod+Q                { close-window; }                 // Close the focused window
    Mod+Ctrl+F           { toggle-window-floating; }       // Float or unfloat the focused window
    Mod+F                { maximize-column; }              // Maximize the focused column
    Mod+Shift+F          { fullscreen-window; }            // Make the focused window fullscreen
    Mod+Left             { focus-column-left; }            // Focus the column to the left
    Mod+Right            { focus-column-right; }           // Focus the column to the right
    Mod+Down             { focus-window-down; }            // Focus the window below
    Mod+Up               { focus-window-up; }              // Focus the window above
    Mod+Ctrl+H           { move-column-left; }             // Move the column to the left
    Mod+Ctrl+L           { move-column-right; }            // Move the column to the right
    Mod+Ctrl+J           { move-window-down; }             // Move the window down
    Mod+Ctrl+K           { move-window-up; }               // Move the window up
    Mod+Home             { focus-column-first; }           // Focus the first column
    Mod+End              { focus-column-last; }            // Focus the last column
    Mod+Ctrl+Home        { move-column-to-first; }         // Move the column to the first position
    Mod+Ctrl+End         { move-column-to-last; }          // Move the column to the last position
    Mod+Shift+h          { set-column-width "-10%"; }      // Make the column narrower by 10%
    Mod+Shift+l          { set-column-width "+10%"; }      // Make the column wider by 10%
    Mod+Shift+k          { set-window-height "-10%"; }     // Make the window shorter by 10%
    Mod+Shift+j          { set-window-height "+10%"; }     // Make the window taller by 10%
    Mod+BracketLeft      { consume-or-expel-window-left; } // Move the window into the column on the left
    Mod+BracketRight     { consume-or-expel-window-right; } // Move the window into the column on the right
    Mod+Comma            { consume-window-into-column; }   // Merge the window into the column to the right
    Mod+Period           { expel-window-from-column; }     // Pop the window out of the column to the right

    // ---- workspaces ----
    Mod+Page_Down        { focus-workspace-down; }         // Go to the workspace below
    Mod+Page_Up          { focus-workspace-up; }           // Go to the workspace above
    Mod+Ctrl+Page_Down   { move-column-to-workspace-down; } // Move the column to the workspace below
    Mod+Ctrl+Page_Up     { move-column-to-workspace-up; }   // Move the column to the workspace above
    Mod+1                { focus-workspace 1; }            // Go to workspace 1
    Mod+2                { focus-workspace 2; }            // Go to workspace 2
    Mod+3                { focus-workspace 3; }            // Go to workspace 3
    Mod+4                { focus-workspace 4; }            // Go to workspace 4
    Mod+5                { focus-workspace 5; }            // Go to workspace 5
    Mod+6                { focus-workspace 6; }            // Go to workspace 6
    Mod+7                { focus-workspace 7; }            // Go to workspace 7
    Mod+8                { focus-workspace 8; }            // Go to workspace 8
    Mod+9                { focus-workspace 9; }            // Go to workspace 9
    Mod+Ctrl+1           { move-column-to-workspace 1; }   // Move the column to workspace 1
    Mod+Ctrl+2           { move-column-to-workspace 2; }   // Move the column to workspace 2
    Mod+Ctrl+3           { move-column-to-workspace 3; }   // Move the column to workspace 3
    Mod+Ctrl+4           { move-column-to-workspace 4; }   // Move the column to workspace 4
    Mod+Ctrl+5           { move-column-to-workspace 5; }   // Move the column to workspace 5
    Mod+Ctrl+6           { move-column-to-workspace 6; }   // Move the column to workspace 6
    Mod+Ctrl+7           { move-column-to-workspace 7; }   // Move the column to workspace 7
    Mod+Ctrl+8           { move-column-to-workspace 8; }   // Move the column to workspace 8
    Mod+Ctrl+9           { move-column-to-workspace 9; }   // Move the column to workspace 9
    Mod+Ctrl+0           { move-column-to-workspace 10; }  // Move the column to workspace 10
    Mod+D                { toggle-overview; }              // Toggle the workspace overview

    // ---- screenshots ----
    Print                { screenshot-screen; }            // Take a screenshot of the whole screen
    Shift+Print          { screenshot; }                   // Take a screenshot of a selected area
    Ctrl+Print           { screenshot-window; }            // Take a screenshot of the focused window
    Mod+Shift+Print      { spawn "screenshot-edit"; }      // Region → swappy editor
    Mod+L                { spawn "hyprlock"; }             // Lock the screen
    Mod+Space            { spawn "kando"; }                // Pie menu (apps, actions)

    // ---- quickshell menus (opened via IPC) ----
    Mod+M                { spawn-sh "quickshell ipc call dashboard-home toggle"; }       // Home dashboard
    Mod+S                { spawn-sh "quickshell ipc call dashboard-stats toggle"; }      // Stats dashboard
    Mod+K                { spawn-sh "quickshell ipc call dashboard-kanban toggle"; }     // Kanban dashboard
    Mod+Shift+C          { spawn-sh "quickshell ipc call dashboard-config toggle"; }     // Config (Keybinds etc.)
    Mod+O                { spawn-sh "quickshell ipc call audioOut-toggle toggle"; }      // Audio output
    Mod+I                { spawn-sh "quickshell ipc call audioIn-toggle toggle"; }       // Audio input
    Mod+Shift+M          { spawn-sh "quickshell ipc call audioMix-toggle toggle"; }      // Audio mixer
    Mod+B                { spawn-sh "quickshell ipc call bluetooth-toggle toggle"; }     // Bluetooth
    Mod+Y                { spawn-sh "quickshell ipc call vpn-toggle toggle"; }           // VPN
    Mod+H                { spawn-sh "quickshell ipc call hotspot-toggle toggle"; }       // Hotspot
    Mod+N                { spawn-sh "quickshell ipc call notification-toggle toggle"; }  // Notifications
    Mod+V                { spawn-sh "quickshell ipc call clipboard-toggle toggle"; }     // Clipboard history
    Mod+Shift+E          { spawn-sh "quickshell ipc call wifi-toggle toggle"; }          // Wi-Fi
    Mod+W          { spawn-sh "quickshell ipc call wallpaper-toggle toggle"; }     // Wallpaper picker
    Mod+P                { spawn-sh "quickshell ipc call PowerMenu-toggle toggle"; }     // Power menu
    Mod+Z                { spawn-sh "quickshell ipc call screenrec-on toggle"; }         // Screen record
    Mod+Shift+S          { spawn-sh "quickshell ipc call focus-toggle toggle"; }         // Focus mode

    // NOTE: bare Escape is intentionally NOT bound — niri would consume it
    // globally and apps would never receive it. Quickshell popups close on
    // Escape themselves; the bar opens via Mod+A.
}
