//---------------------- window rules ----------------------\\
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 1.0; }
}

// Picture-in-Picture: float on top of tiled windows, sized like a video,
// pinned to the main screen (corner, below the bar).
window-rule {
    match title=r#"^(Picture.?in.?Picture|img-pip-view)$"#

    open-floating true
    default-column-width { fixed 426; }
    default-window-height { fixed 240; }
    default-floating-position x=16 y=16 relative-to="top-right"
}

// Runtime overrides (seat from WallpaperService UpdateBorders):
// optional so a missing file (fresh profile, before any wallpaper apply)
// never breaks parsing.
include optional=true "~/.local/state/niri/focus-ring.user.kdl"