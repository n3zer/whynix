//---------------------- window rules ----------------------\\
window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    match app-id="firefox"
    default-column-width { proportion 1.0; }
}

// Runtime overrides (seat from WallpaperService UpdateBorders):
// optional so a missing file (fresh profile, before any wallpaper apply)
// never breaks parsing.
include optional=true "~/.local/state/niri/focus-ring.user.kdl"